+/// Perform in-place hot reload against a live `Router` (used both by `BoxInstance::reload_in_place`
+/// and by Clash REST API `PUT /configs`).
+pub async fn reload_router_in_place(router: &Arc<Router>, new_root: &Value) -> anyhow::Result<()> {
+    if let Some(old_root) = router.live_root() {
+        anyhow::ensure!(
+            can_reload_in_place(&old_root, new_root),
+            "cannot reload in-place: inbounds, clash_api, netns, ntp or cache_file configuration changed"
+        );
+    }
+    let cache_file = router.cache_file();
+    reload_router_with_cache(router, &cache_file, new_root).await
+}
+
+async fn reload_router_with_cache(
+    router: &Arc<Router>,
+    cache_file: &Option<cache_file::SharedCacheFile>,
+    new_root: &Value,
+) -> anyhow::Result<()> {
+    warn_unhonored_options(new_root);
+
+    // 1. Build and validate new router inner BEFORE mutating anything running
+    let mut new_inner = router.build_inner_for_reload(new_root)?;
+
+    // 2. Build and validate new DNS service BEFORE mutating anything running
+    let new_dns = dns::DnsService::build_with_registry(new_root, new_inner.rule_sets())
+        .context("dns section")?;
+
+    // 3. Stage state inheritance, remote rule sets, and endpoints BEFORE swapping live state
+    router.prepare_staging(&mut new_inner);
+    let new_inner = Arc::new(new_inner);
+    let staging_router = Router::stage_from_inner(Arc::clone(&new_inner));
+    if let Some(service) = &new_dns {
+        service.attach_cache(cache_file.clone());
+        service.set_router(Arc::clone(&staging_router));
+    }
+    let stage_res: anyhow::Result<()> = async {
+        new_inner
+            .rule_sets()
+            .start_remote(&staging_router, cache_file.clone())
+            .await?;
+        new_inner
+            .start_endpoints()
+            .await
+            .map_err(anyhow::Error::from)?;
+        Ok(())
+    }
+    .await;
+    if let Err(err) = stage_res {
+        for task in new_inner.take_probe_tasks() {
+            task.abort();
+        }
+        return Err(err);
+    }
+
+    // 4. Migrate active DNS cache, server addrs, reverse mappings, and fakeip pools
+    let old_dns = dns::current();
+    if let (Some(new_svc), Some(old_svc)) = (&new_dns, &old_dns) {
+        new_svc.migrate_from(old_svc);
+    }
+
+    // 5. Atomically commit the staged router inner
+    router.commit_staged(new_inner).await;
+
+    // 6. Connect DNS service to the live shared router and publish globally
+    if let Some(service) = &new_dns {
+        service.set_router(Arc::clone(router));
+    }
+    dns::set_service(new_dns);
+
+    // 7. Hot-apply log settings
+    let log = new_root.get("log");
+    let level = log.and_then(|l| l.get("level")).and_then(Value::as_str);
+    let disabled = log
+        .and_then(|l| l.get("disabled"))
+        .and_then(Value::as_bool)
+        .unwrap_or(false);
+    if let Some(lvl) = level {
+        logging::set_level(lvl);
+    }
+    logging::set_enabled(!disabled);
+
+    if let Some(sub_rt) = router.subscription_runtime() {
+        let _ = sub_rt.reexpand(new_root);
+    }
+    // only a successful in-place swap moves the applied-config revision
+    router.record_config(new_root);
+    Ok(())
+}
