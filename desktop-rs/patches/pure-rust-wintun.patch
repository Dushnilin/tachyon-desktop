+    fn windows_wintun_pure_rust_ring_math_and_embedded_driver() {
+        assert_eq!(windows_tun::tun_align(1), 4);
+        assert_eq!(windows_tun::tun_align(4), 4);
+        assert_eq!(windows_tun::tun_align(5), 8);
+        assert_eq!(windows_tun::tun_max_packet_size(), 65540);
+        // 12 (TunRing header) + 4_194_304 (4 MiB) + (65540 - 4) = 4_259_852
+        assert_eq!(windows_tun::tun_ring_size(0x0040_0000), 4_259_852);
